<div class="row mt-3">
    <div class="col-8 offset-3 d-flex gap-2">
        <a href="/listings/<%= listing.id %>/edit" class="btn" style="background-color: #fe424d; color:white">Edit</a>
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
            <button class="btn btn-dark">Delete</button>
        </form>
    </div>
</div>
<% } %>
<br>
<br><hr>

