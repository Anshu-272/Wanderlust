<% layout("/layouts/boilerplate")%> 
<%= success %>


<style>
  /* =================================== */
  /* ===== STYLES FOR LARGE SCREEN ===== */
  /* =================================== */

  /* CORRECTED: This is the main container for filters AND the tax toggle */
  #filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between; /* Pushes icons left, toggle right */
    align-items: center;
  }

  /* NEW: This is the container for ONLY the icons */
  .filter-items {
    display: flex;
  }
  
  /* Resets the default blue link color */
  a.filter {
    color: #222222;
    text-decoration: none;
  }

  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 1.5rem;
    opacity: 0.7;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
    color: #fe424d;
  }

  .filter.active {
    opacity: 1;
    border-bottom: 2px solid #fe424d; /* Semicolon is here and correct */
  }

  .filter p {
    font-size: 0.8rem;
  }

  /* CORRECTED: This is the style for the tax toggle on large screens */
  .tax-toggle {
    border: 2.5px solid #fe424d;
    border-radius: 1rem;
    height: 3.2rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    margin-top: 1rem;
  }

  .tax-info {
    display: none;
  }

  /* =================================== */
  /* ===== STYLES FOR SMALL SCREEN ===== */
  /* =================================== */
  @media (max-width: 992px) {
    
    /* Makes ONLY the icon container scrollable */
    .filter-items {
      width: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .filter-items::-webkit-scrollbar {
      display: none;
    }

    /* Allows the tax toggle to wrap to the next line */
    #filters {
      flex-wrap: wrap;
    }

    /* Styles the tax toggle for small screens */
    .tax-toggle {
      width: 100%;
      justify-content: flex-start;
      margin-left: 0;
      margin-top: 1.5rem;
    }
  }
</style>


    <div id="filters">
